# ═══════════════════════════════════════════════════════════════════
# DATABASE (Required - Get free from Render, Supabase, or Neon)
# ═══════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ═══════════════════════════════════════════════════════════════════
# AI PROVIDERS (All free tiers - get as many as possible for fallbacks)
# ═══════════════════════════════════════════════════════════════════

# Google Gemini (Free: 60 req/min) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq (Free: 30 req/min) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=

# OpenRouter (Free models available) - https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Cerebras (Free: 30 req/min) - https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Together AI (Free tier) - https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Cohere (Free: 5 req/min) - https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# HuggingFace (Free inference) - https://huggingface.co/settings/tokens
HF_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# WEB SEARCH (Optional but recommended for better research)
# ═══════════════════════════════════════════════════════════════════

# Serper (Free: 2500 searches/month) - https://serper.dev/
SERPER_API_KEY=

# Jina AI (Free tier) - https://jina.ai/
JINA_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# NOTIFICATIONS (Optional - all free)
# ═══════════════════════════════════════════════════════════════════

# Telegram - Message @BotFather to create bot, @userinfobot for chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook - Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Slack Webhook - https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL SETTINGS
# ═══════════════════════════════════════════════════════════════════

# Minimum score to send notifications (default: 7)
MIN_SCORE_TO_NOTIFY=7

# Research cycle interval in minutes (default: 15)
CYCLE_INTERVAL_MINUTES=15

# Max results per topic before marking as saturated (default: 5)
MAX_RESULTS_PER_TOPIC=5
